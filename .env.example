# Copy to .env.local and fill in. NEXT_PUBLIC_ values are inlined into the browser
# bundle at build time, so rebuild (or restart `npm run dev`) after changing them.

# Formspree endpoint that receives contact-form submissions (must be https://), e.g. https://formspree.io/f/xxxxxxxx
NEXT_PUBLIC_FORMSPREE_URL=

# Conference registrations → Zoho Sheet (server-only: never prefix these with NEXT_PUBLIC_).
# Setup: docs/registration-sheet.md
ZOHO_DC=in
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_SHEET_RESOURCE_ID=
ZOHO_SHEET_WORKSHEET=Registrations
